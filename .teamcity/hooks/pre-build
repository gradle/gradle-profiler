# Repository-level copy of the agent hook from https://github.com/gradle/dev-infrastructure/pull/3484.
# maven-mirrors.sh is kept identical to salt/common/maven-mirror-hooks/maven-mirrors.sh there;
# only the user home differs, since this script lives in the checkout instead of <agent home>/hooks.
# Remove these hooks once the agent hooks are rolled out.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=.teamcity/hooks/maven-mirrors.sh
source "${SCRIPT_DIR}/maven-mirrors.sh"

gradleUserHome="${GRADLE_USER_HOME:-${HOME}/.gradle}"
echo "[maven-mirror pre-build] HOME=${HOME} GRADLE_USER_HOME=${gradleUserHome} IGNORE_MIRROR=${IGNORE_MIRROR:-}"
provisionMavenMirrors "${HOME}/.m2/settings.xml" "${gradleUserHome}"
echo "[maven-mirror pre-build] Generated lines in ${gradleUserHome}/gradle.properties:"
grep -A1 -xF "# ${GENERATED_BY_PRE_BUILD}" "${gradleUserHome}/gradle.properties" 2>/dev/null || echo "  (none)"
